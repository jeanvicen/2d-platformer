{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/eclipse/particles/soft"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 4"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.radius ?? 0.8",
        "direction": "outwards",
        "plane_normal": "y"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.5,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.2 + v.particle_random_1 * 0.8"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.14 * math.sin(v.particle_age / v.particle_lifetime * 180) + 0.02",
          "0.14 * math.sin(v.particle_age / v.particle_lifetime * 180) + 0.02"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "math.clamp(1.2 - v.particle_age / v.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
