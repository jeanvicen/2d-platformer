{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:smoke_puff",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/eclipse/particles/smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 10"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius ?? 0.5",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "v.speed ?? 0.8",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + v.particle_random_1 * 0.6"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_2 * 360",
        "rotation_rate": 30
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 + v.particle_age * 0.7",
          "0.3 + v.particle_age * 0.7"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "math.clamp(1.2 - v.particle_age / v.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
