{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:violet_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/eclipse/particles/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "4 + v.particle_random_1 * 3",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -1.5,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_2 * 0.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 * (1 - v.particle_age / v.particle_lifetime) + 0.04",
          "0.22 * (1 - v.particle_age / v.particle_lifetime) + 0.04"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFE8D0FF",
            "0.5": "#FFA050FF",
            "1.0": "#008040FF"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
}
