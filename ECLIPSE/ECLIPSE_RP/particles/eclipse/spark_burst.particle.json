{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "eclipse:spark_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/eclipse/particles/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 18"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius ?? 0.4",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 3) * (0.6 + v.particle_random_1 * 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "v.gravity ?? -1.0",
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + v.particle_random_2 * 0.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1 - v.particle_age / v.particle_lifetime) + 0.03",
          "0.18 * (1 - v.particle_age / v.particle_lifetime) + 0.03"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.r",
          "v.color.g",
          "v.color.b",
          "math.clamp(1.2 - v.particle_age / v.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
