{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.eclipse.form_titan.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "air": "!q.is_on_ground"
            },
            {
              "run": "q.modified_move_speed > 0.8 && q.is_sprinting"
            },
            {
              "walk": "q.modified_move_speed > 0.1"
            }
          ],
          "blend_transition": 0.25
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "air": "!q.is_on_ground"
            },
            {
              "run": "q.is_sprinting"
            },
            {
              "default": "q.modified_move_speed < 0.05"
            }
          ],
          "blend_transition": 0.2
        },
        "run": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "air": "!q.is_on_ground"
            },
            {
              "walk": "!q.is_sprinting"
            }
          ],
          "blend_transition": 0.2
        },
        "air": {
          "animations": [
            "air"
          ],
          "transitions": [
            {
              "default": "q.is_on_ground"
            }
          ],
          "blend_transition": 0.25
        }
      }
    }
  }
}
