{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.eclipse.nox.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "sit": "q.property('eclipse:state') == 'stay'"
            },
            {
              "walk": "q.ground_speed > 0.35"
            }
          ],
          "blend_transition": 0.3
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "default": "q.ground_speed < 0.2"
            }
          ],
          "blend_transition": 0.25
        },
        "sit": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "default": "q.property('eclipse:state') != 'stay'"
            }
          ],
          "blend_transition": 0.5
        },
        "takeoff": {
          "animations": [
            "takeoff"
          ],
          "transitions": [
            {
              "air": "q.all_animations_finished"
            }
          ],
          "blend_transition": 0.2
        },
        "air": {
          "animations": [
            "hover"
          ],
          "transitions": [
            {
              "land": "q.is_on_ground"
            },
            {
              "glide": "q.vertical_speed < -1.6"
            },
            {
              "fly": "q.ground_speed > 1.6"
            }
          ],
          "blend_transition": 0.35
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "land": "q.is_on_ground"
            },
            {
              "glide": "q.vertical_speed < -1.6"
            },
            {
              "air": "q.ground_speed < 1.0"
            }
          ],
          "blend_transition": 0.35
        },
        "glide": {
          "animations": [
            "glide"
          ],
          "transitions": [
            {
              "land": "q.is_on_ground"
            },
            {
              "fly": "q.vertical_speed > -0.6 && q.ground_speed > 1.6"
            },
            {
              "air": "q.vertical_speed > -0.6"
            }
          ],
          "blend_transition": 0.5
        },
        "land": {
          "animations": [
            "land"
          ],
          "transitions": [
            {
              "default": "q.all_animations_finished"
            },
            {
              "air": "!q.is_on_ground && q.anim_time > 0.3"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.eclipse.nox.phase": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "manifest": "q.property('eclipse:phase') == 'manifest'"
            },
            {
              "recall": "q.property('eclipse:phase') == 'recall'"
            },
            {
              "special": "q.property('eclipse:phase') == 'special'"
            },
            {
              "interact": "q.property('eclipse:phase') == 'interact'"
            }
          ]
        },
        "manifest": {
          "animations": [
            "manifest"
          ],
          "transitions": [
            {
              "recall": "q.property('eclipse:phase') == 'recall'"
            },
            {
              "default": "q.property('eclipse:phase') != 'manifest'"
            }
          ],
          "blend_transition": 0.1
        },
        "recall": {
          "animations": [
            "recall"
          ],
          "transitions": [
            {
              "default": "q.property('eclipse:phase') != 'recall'"
            }
          ]
        },
        "special": {
          "animations": [
            "special"
          ],
          "transitions": [
            {
              "recall": "q.property('eclipse:phase') == 'recall'"
            },
            {
              "default": "q.all_animations_finished || q.property('eclipse:phase') != 'special'"
            }
          ],
          "blend_transition": 0.25
        },
        "interact": {
          "animations": [
            "interact"
          ],
          "transitions": [
            {
              "recall": "q.property('eclipse:phase') == 'recall'"
            },
            {
              "default": "q.all_animations_finished || q.property('eclipse:phase') != 'interact'"
            }
          ],
          "blend_transition": 0.25
        }
      }
    },
    "controller.animation.eclipse.nox.fidget": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "wing_stretch": "q.ground_speed < 0.1 && q.property('eclipse:phase') == 'idle' && q.property('eclipse:state') != 'stay' && math.random(0, 1) < 0.00160"
            }
          ]
        },
        "wing_stretch": {
          "animations": [
            "wing_stretch"
          ],
          "transitions": [
            {
              "default": "q.all_animations_finished || q.ground_speed > 0.4 || q.property('eclipse:phase') != 'idle'"
            }
          ],
          "blend_transition": 0.35
        }
      }
    }
  }
}
