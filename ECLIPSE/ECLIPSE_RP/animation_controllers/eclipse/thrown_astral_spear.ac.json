      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "spin"
          ],
          "transitions": [
            {
              "rest": "!q.property('eclipse:spin')"
            }
          ],
          "blend_transition": 0.2
        },
        "rest": {
          "animations": [
            "rest"
          ],
          "transitions": [
            {
              "default": "q.property('eclipse:spin')"
            }
          ],
          "blend_transition": 0.3
        }
      }
    }
  }
}
