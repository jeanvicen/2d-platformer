{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shadowbound:sparkle",
      "basic_render_parameters": { "material": "particles_blend", "texture": "textures/particle/shadowbound_sparkle" }
    },
    "components": {
      "minecraft:emitter_initialization": { "creation_expression": "variable.r = variable.color.r ?? 0.85; variable.g = variable.color.g ?? 0.65; variable.b = variable.color.b ?? 1.0;" },
      "minecraft:emitter_rate_instant": { "num_particles": 14 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.1 },
      "minecraft:emitter_shape_sphere": { "radius": 0.7, "direction": "outwards" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.6, 1.3)" },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.4)",
      "minecraft:particle_motion_dynamic": { "linear_acceleration": [0, 0.8, 0], "linear_drag_coefficient": 2.5 },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.03 + 0.09 * (1 - variable.particle_age / variable.particle_lifetime)", "0.03 + 0.09 * (1 - variable.particle_age / variable.particle_lifetime)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [0, 0], "uv_size": [16, 16] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.r", "variable.g", "variable.b", "1 - variable.particle_age / variable.particle_lifetime"]
      }
    }
  }
}
