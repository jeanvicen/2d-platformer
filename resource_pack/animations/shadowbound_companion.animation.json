    "animation.shadowbound.face": {
      "loop": true,
      "bones": {
        "eyes_happy": {
          "scale": "query.property('shadowbound:mood') == 1 ? 1 : 0"
        },
        "blush": {
          "scale": "query.property('shadowbound:mood') == 1 ? 1 : 0"
        },
        "brows": {
          "scale": "query.property('shadowbound:mood') == 2 ? 1 : 0"
