{
  "name": "shadowbound",
  "version": "1.0.0",
  "private": true,
  "description": "SHADOWBOUND - companheiras de sombra autônomas para Minecraft Bedrock (Android e Windows)",
  "type": "module",
  "scripts": {
    "art": "python3 tools/art/generate_art.py && python3 tools/art/generate_anims.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tools/run-tests.mjs",
    "validate": "node tools/validate-packs.mjs",
    "build": "node tools/build.mjs",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@minecraft/server": "2.3.0",
    "@minecraft/server-ui": "2.1.0",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
