{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lila.lila": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "is_hurt_color": {
        "r": "0.85",
        "g": "0.25",
        "b": "0.25",
        "a": "0.35"
      },
      "on_fire_color": {
        "r": "1.0",
        "g": "0.5",
        "b": "0.2",
        "a": "0.4"
      }
    },
    "controller.render.lila.forms": {
      "arrays": {
        "geometries": {
          "Array.geo": [
            "Geometry.default",
            "Geometry.heli",
            "Geometry.car",
            "Geometry.excavator",
            "Geometry.tank",
            "Geometry.jet",
            "Geometry.moto",
            "Geometry.colossus",
            "Geometry.turret_g",
            "Geometry.swarm",
            "Geometry.ship",
            "Geometry.ufo",
            "Geometry.sub",
            "Geometry.boat",
            "Geometry.truck",
            "Geometry.stealth"
          ]
        },
        "textures": {
          "Array.tex": [
            "Texture.default",
            "Texture.heli",
            "Texture.car",
            "Texture.excavator",
            "Texture.tank",
            "Texture.jet",
            "Texture.moto",
            "Texture.colossus",
            "Texture.turret_g",
            "Texture.swarm",
            "Texture.ship",
            "Texture.ufo",
            "Texture.sub",
            "Texture.boat",
            "Texture.truck",
            "Texture.stealth"
          ]
        }
      },
      "geometry": "Array.geo[q.property('lila:form')]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.tex[q.property('lila:form')]"
      ],
      "part_visibility": [
        {
          "*": "q.property('lila:form') != 9 && !(q.property('lila:off') && v.ot > 2.9)"
        }
      ],
      "is_hurt_color": {
        "r": "0.85",
        "g": "0.25",
        "b": "0.25",
        "a": "0.25"
      }
    },
    "controller.render.lila.robot": {
      "arrays": {
        "textures": {
          "Array.kind": [
            "Texture.default",
            "Texture.construtor",
            "Texture.artilheiro",
            "Texture.medico",
            "Texture.ninja"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.kind[q.property('lila:kind')]"
      ],
      "part_visibility": [
        {
          "hat": "q.property('lila:kind') == 1"
        },
        {
          "cannon": "q.property('lila:kind') == 2"
        },
        {
          "medkit": "q.property('lila:kind') == 3"
        },
        {
          "katana": "q.property('lila:kind') == 4"
        }
      ],
      "is_hurt_color": {
        "r": "0.85",
        "g": "0.25",
        "b": "0.25",
        "a": "0.35"
      }
    },
    "controller.render.lila.item": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    }
  }
}
