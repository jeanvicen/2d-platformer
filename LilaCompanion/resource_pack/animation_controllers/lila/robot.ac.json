{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lila.robot.action": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "walk": "q.is_on_ground"
            },
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "shoot": "q.property('lila:action') == 'shoot'"
            },
            {
              "punch": "q.property('lila:action') == 'punch'"
            },
            {
              "give": "q.property('lila:action') == 'give'"
            },
            {
              "spawn": "q.property('lila:action') == 'spawn'"
            },
            {
              "build": "q.property('lila:action') == 'build'"
            },
            {
              "slash": "q.property('lila:action') == 'slash'"
            },
            {
              "heal": "q.property('lila:action') == 'heal'"
            }
          ]
        },
        "shoot": {
          "animations": [
            "shoot",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'shoot'"
            }
          ]
        },
        "punch": {
          "animations": [
            "punch",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'punch'"
            }
          ]
        },
        "give": {
          "animations": [
            "give",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'give'"
            }
          ]
        },
        "spawn": {
          "animations": [
            "spawn",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'spawn'"
            }
          ]
        },
        "build": {
          "animations": [
            "build",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'build'"
            }
          ]
        },
        "slash": {
          "animations": [
            "slash",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'slash'"
            }
          ]
        },
        "heal": {
          "animations": [
            "heal",
            {
              "fly": "!q.is_on_ground"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'heal'"
            }
          ]
        }
      }
    }
  }
}
