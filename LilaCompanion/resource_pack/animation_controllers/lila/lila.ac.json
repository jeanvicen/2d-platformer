{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lila.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "walk": "q.property('lila:move') == 'walk'"
            },
            {
              "run": "q.property('lila:move') == 'run'"
            },
            {
              "swim": "q.property('lila:move') == 'swim'"
            },
            {
              "climb": "q.property('lila:move') == 'climb'"
            },
            {
              "fall": "q.property('lila:move') == 'fall'"
            },
            {
              "sneak": "q.property('lila:move') == 'sneak'"
            },
            {
              "native": "q.property('lila:move') == 'none' && q.ground_speed > 0.4"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'walk'"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'run'"
            }
          ]
        },
        "swim": {
          "animations": [
            "swim"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'swim'"
            }
          ]
        },
        "climb": {
