          "transitions": [
            {
              "default": "q.property('lila:move') != 'climb'"
            }
          ]
        },
        "fall": {
          "animations": [
            "fall"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'fall'"
            }
          ]
        },
        "sneak": {
          "animations": [
            "sneak"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'sneak'"
            }
          ]
        },
        "native": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "q.property('lila:move') != 'none' || q.ground_speed < 0.25"
            }
          ]
        }
      }
    },
