{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lila.drone.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "still"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "dash": "q.property('lila:move') == 'run' || q.ground_speed > 6"
            },
            {
              "fly": "q.property('lila:move') != 'none' || q.ground_speed > 0.5"
            }
          ]
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "dash": "q.property('lila:move') == 'run' || q.ground_speed > 6"
            },
            {
              "default": "q.property('lila:move') == 'none' && q.ground_speed < 0.3"
            }
          ]
        },
        "dash": {
          "animations": [
            "dash"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "fly": "q.property('lila:move') != 'run' && q.ground_speed < 5"
            }
          ]
        }
      }
    },
    "controller.animation.lila.drone.action": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.2,
          "transitions": [
            {
              "work": "q.property('lila:action') == 'work'"
            },
            {
              "place": "q.property('lila:action') == 'place'"
            },
            {
              "shoot": "q.property('lila:action') == 'shoot'"
            },
            {
              "charge": "q.property('lila:action') == 'charge'"
            },
            {
              "turret": "q.property('lila:action') == 'turret'"
            },
            {
              "craft": "q.property('lila:action') == 'craft'"
            },
            {
              "wave": "q.property('lila:action') == 'wave'"
            },
            {
              "sleep": "q.property('lila:action') == 'sleep'"
            },
            {
              "defeat": "q.property('lila:action') == 'defeat'"
            },
            {
              "summon": "q.property('lila:action') == 'summon'"
            },
            {
              "celebrate": "q.property('lila:action') == 'celebrate'"
            },
            {
              "scan": "q.property('lila:action') == 'scan'"
            }
          ]
        },
        "work": {
          "animations": [
            "work"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'work'"
            }
          ]
        },
        "place": {
          "animations": [
            "place"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'place'"
            }
          ]
        },
        "shoot": {
          "animations": [
            "shoot"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'shoot'"
            }
          ]
        },
        "charge": {
          "animations": [
            "charge"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'charge'"
            }
          ]
        },
        "turret": {
          "animations": [
            "turret"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'turret'"
            }
          ]
        },
        "craft": {
          "animations": [
            "craft"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'craft'"
            }
          ]
        },
        "wave": {
          "animations": [
            "wave"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'wave'"
            }
          ]
        },
        "sleep": {
          "animations": [
            "sleep"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'sleep'"
            }
          ]
        },
        "defeat": {
          "animations": [
            "defeat"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'defeat'"
            }
          ]
        },
        "summon": {
          "animations": [
            "summon"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'summon'"
            }
          ]
        },
        "celebrate": {
          "animations": [
            "celebrate"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'celebrate'"
            }
          ]
        },
        "scan": {
          "animations": [
            "scan"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'scan'"
            }
          ]
        }
      }
    },
    "controller.animation.lila.form.action": {
      "initial_state": "default",
      "states": {
        "default": {
          "blend_transition": 0.15,
          "transitions": [
            {
              "work": "q.property('lila:action') == 'work' && v.form != 0"
            },
            {
              "place": "q.property('lila:action') == 'place' && v.form != 0"
            },
            {
              "shoot": "q.property('lila:action') == 'shoot' && v.form != 0"
            },
            {
              "charge": "q.property('lila:action') == 'charge' && v.form != 0"
            },
            {
              "celebrate": "q.property('lila:action') == 'celebrate' && v.form != 0"
            },
            {
              "wave": "q.property('lila:action') == 'wave' && v.form != 0"
            },
            {
              "defeat": "q.property('lila:action') == 'defeat' && v.form != 0"
            }
          ]
        },
        "work": {
          "animations": [
            {
              "col_punch": "v.form == 7"
            },
            {
              "exc_dig": "v.form == 3"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'work' || v.form == 0"
            }
          ]
        },
        "place": {
          "animations": [
            {
              "col_stomp": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'place' || v.form == 0"
            }
          ]
        },
        "shoot": {
          "animations": [
            {
              "tank_fire": "v.form == 4"
            },
            {
              "turret_fire": "v.form == 8"
            },
            {
              "heli_fire": "v.form == 1"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'shoot' || v.form == 0"
            }
          ]
        },
        "charge": {
          "animations": [
            {
              "col_beam": "v.form == 7"
            },
            {
              "turret_missile": "v.form == 8"
            },
            {
              "jet_missile": "v.form == 5"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'charge' || v.form == 0"
            }
          ]
        },
        "celebrate": {
          "animations": [
            {
              "col_roar": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'celebrate' || v.form == 0"
            }
          ]
        },
        "wave": {
          "animations": [
            {
              "col_wave": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'wave' || v.form == 0"
            }
          ]
        },
        "defeat": {
          "animations": [
            {
              "col_defeat": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'defeat' || v.form == 0"
            }
          ]
        }
      }
    }
  }
}
