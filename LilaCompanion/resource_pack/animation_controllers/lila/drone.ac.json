            },
            {
              "defeat": "q.property('lila:action') == 'defeat' && v.form != 0"
            }
          ]
        },
        "work": {
          "animations": [
            {
              "col_punch": "v.form == 7"
            },
            {
              "exc_dig": "v.form == 3"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'work' || v.form == 0"
            }
          ]
        },
        "place": {
          "animations": [
            {
              "col_stomp": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'place' || v.form == 0"
            }
          ]
        },
        "shoot": {
          "animations": [
            {
              "tank_fire": "v.form == 4"
            },
            {
              "turret_fire": "v.form == 8"
            },
            {
              "heli_fire": "v.form == 1"
            },
            {
              "ship_fire": "v.form == 10"
            },
            {
              "ufo_fire": "v.form == 11"
            },
            {
              "sub_fire": "v.form == 12"
            },
            {
              "swarm_fire": "v.form == 9"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'shoot' || v.form == 0"
            }
          ]
        },
        "charge": {
          "animations": [
            {
              "col_beam": "v.form == 7"
            },
            {
              "turret_missile": "v.form == 8"
            },
            {
              "jet_missile": "v.form == 5 || v.form == 15"
            },
            {
              "ufo_fire": "v.form == 11"
            },
            {
              "swarm_fire": "v.form == 9"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'charge' || v.form == 0"
            }
          ]
        },
        "celebrate": {
          "animations": [
            {
              "col_roar": "v.form == 7"
            }
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "q.property('lila:action') != 'celebrate' || v.form == 0"
            }
