{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/nano"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          1.0,
          0
        ],
        "radius": 1.2,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.02, 0.25)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.8, 3.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 300 + v.particle_random_1 * 720) * 0.35",
          "math.cos(v.particle_age * 260 + v.particle_random_2 * 720) * 0.2 - 0.04",
          "math.cos(v.particle_age * 330 + v.particle_random_3 * 720) * 0.35"
        ],
        "linear_drag_coefficient": 1.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.035 + v.particle_random_3 * 0.04",
          "0.035 + v.particle_random_3 * 0.04"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_4 > 0.9 ? 1.0 : 0.06 + v.particle_random_2 * 0.05",
          "v.particle_random_4 > 0.9 ? 0.42 + 0.3 * math.sin(v.particle_age * 900 + v.particle_random_1 * 360) : 0.055 + v.particle_random_2 * 0.045",
          "v.particle_random_4 > 0.9 ? 0.1 : 0.075 + v.particle_random_2 * 0.06",
          "math.clamp(math.min(v.particle_age * 5, (v.particle_lifetime - v.particle_age) * 4), 0, 1) * 0.95"
        ]
      }
    }
  }
}
