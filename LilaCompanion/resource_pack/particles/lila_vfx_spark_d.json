{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:vfx_spark_d",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/vfx/glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.cr = v.cr ?? 1; v.cg = v.cg ?? 1; v.cb = v.cb ?? 1; v.dr = v.dr ?? 0; v.dg = v.dg ?? 0; v.db = v.db ?? 0; v.size = v.size ?? 1; v.life = v.life ?? 0.5; v.n = v.n ?? 12; v.rot = v.rot ?? 0; v.h = v.h ?? 6; v.race = v.race ?? 0; v.grav = v.grav ?? 4; v.out = v.out ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.n"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.2 * v.size",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(2, 7) * math.sqrt(v.size)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "-v.grav",
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-400, 400)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.random(0.07, 0.15) * math.sqrt(v.size) * (1 - (v.particle_age / v.particle_lifetime) * 0.7)",
          "math.random(0.07, 0.15) * math.sqrt(v.size) * (1 - (v.particle_age / v.particle_lifetime) * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(v.cr, v.dr, (v.particle_age / v.particle_lifetime))",
          "math.lerp(v.cg, v.dg, (v.particle_age / v.particle_lifetime))",
          "math.lerp(v.cb, v.db, (v.particle_age / v.particle_lifetime))",
          "1 - (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
