{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_pile",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/nano"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 45,
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.05,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.7)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.particle_random_2 * 360)) * (math.sqrt(v.particle_random_1) * 0.75)",
          "(1 - (math.sqrt(v.particle_random_1) * 0.75) / 0.75) * 0.3 * v.particle_random_3 + math.sin(v.particle_age * 500 + v.particle_random_4 * 360) * 0.012",
          "math.sin((v.particle_random_2 * 360)) * (math.sqrt(v.particle_random_1) * 0.75)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.028 + v.particle_random_3 * 0.022",
          "0.028 + v.particle_random_3 * 0.022"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_4 > 0.83 ? 0.25 + 0.2 * math.sin(v.particle_age * 900 + v.particle_random_1 * 360) : 0.12",
          "v.particle_random_4 > 0.83 ? 0.45 : 0.15",
          "v.particle_random_4 > 0.83 ? 0.55 : 0.19",
          "math.clamp(math.min(v.particle_age * 5, (v.particle_lifetime - v.particle_age) * 4), 0, 1) * 0.95"
        ]
      }
    }
  }
}
