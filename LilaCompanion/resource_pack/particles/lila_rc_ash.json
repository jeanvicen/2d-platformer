{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:rc_ash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/soft"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.6,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.5, 2.6)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 200) * 0.6",
          -0.7,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.14 * (1 - v.particle_age / v.particle_lifetime * 0.6)",
          "0.14 * (1 - v.particle_age / v.particle_lifetime * 0.6)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FF9A9590",
            "0.7": "#FF55524E",
            "1.0": "#00302E2C"
          }
        }
      }
    }
  }
}
