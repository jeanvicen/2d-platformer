{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_aura",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/nano"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sx = v.sx ?? 1.2; v.sy = v.sy ?? 0.8; v.sz = v.sz ?? 1.6;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 38,
        "max_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.1
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          "v.sy",
          0
        ],
        "half_dimensions": [
          "v.sx",
          "v.sy",
          "v.sz"
        ],
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.05, 0.25)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7, 1.3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 700 + v.particle_random_1 * 720) * 0.8",
          "0.1",
          "math.cos(v.particle_age * 650 + v.particle_random_2 * 720) * 0.8"
        ],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.035 + v.particle_random_3 * 0.04",
          "0.035 + v.particle_random_3 * 0.04"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_4 > 0.9 ? 1.0 : 0.06 + v.particle_random_2 * 0.05",
          "v.particle_random_4 > 0.9 ? 0.42 + 0.3 * math.sin(v.particle_age * 900 + v.particle_random_1 * 360) : 0.055 + v.particle_random_2 * 0.045",
          "v.particle_random_4 > 0.9 ? 0.1 : 0.075 + v.particle_random_2 * 0.06",
          "math.clamp(math.min(v.particle_age * 5, (v.particle_lifetime - v.particle_age) * 4), 0, 1) * 0.95"
        ]
      }
    }
  }
}
