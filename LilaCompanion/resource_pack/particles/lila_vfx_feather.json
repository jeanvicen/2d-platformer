{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:vfx_feather",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/vfx/feather"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.cr = v.cr ?? 1; v.cg = v.cg ?? 1; v.cb = v.cb ?? 1; v.dr = v.dr ?? 0; v.dg = v.dg ?? 0; v.db = v.db ?? 0; v.size = v.size ?? 1; v.life = v.life ?? 0.5; v.n = v.n ?? 12; v.rot = v.rot ?? 0; v.h = v.h ?? 6; v.race = v.race ?? 0; v.grav = v.grav ?? 4; v.out = v.out ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.n"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.4 * v.size",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.4)"
      },
      "minecraft:particle_initial_speed": "math.random(1, 3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 260 + v.particle_random_1 * 360) * 2",
          -0.9,
          "math.cos(v.particle_age * 200) * 1.2"
        ],
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-120, 120)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15",
          "0.15"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(v.cr, 1, 0)",
          "math.lerp(v.cg, 1, 0)",
          "math.lerp(v.cb, 1, 0)",
          "math.min(1, (1 - (v.particle_age / v.particle_lifetime)) * 3)"
        ]
      }
    }
  }
}
