{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:curse_wing",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/vfx/smoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.yaw = v.yaw ?? 0; v.flap = v.flap ?? 0; v.span = v.span ?? 3.4; v.size = v.size ?? 1;"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.08
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 46
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.22, 0.34)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.yaw) * (v.particle_random_2 > 0.5 ? 1 : -1) * (v.particle_random_1 * v.span) - math.sin(v.yaw) * -(0.35 + v.particle_random_1 * 0.6 + (1 - math.sin(v.flap)) * v.particle_random_1 * 0.3)",
          "(1.0 + math.sin(v.particle_random_1 * 180) * 0.9 - v.particle_random_1 * 0.4 + math.sin(v.flap) * v.particle_random_1 * 1.1 - v.particle_random_3 * v.particle_random_1 * 1.4)",
          "math.sin(v.yaw) * (v.particle_random_2 > 0.5 ? 1 : -1) * (v.particle_random_1 * v.span) + math.cos(v.yaw) * -(0.35 + v.particle_random_1 * 0.6 + (1 - math.sin(v.flap)) * v.particle_random_1 * 0.3)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.32 + (1 - v.particle_random_1) * 0.3) * (1 + (v.particle_age / v.particle_lifetime) * 0.4)",
          "(0.32 + (1 - v.particle_random_1) * 0.3) * (1 + (v.particle_age / v.particle_lifetime) * 0.4)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.05",
          "0.045",
          "0.065",
          "math.min(1, (v.particle_age / v.particle_lifetime) * 8) * (1 - (v.particle_age / v.particle_lifetime)) * 0.95"
        ]
      }
    }
  }
}
