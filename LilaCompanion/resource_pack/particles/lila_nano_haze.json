{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_haze",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/soft"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 8,
        "max_particles": 22
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          1.05,
          0
        ],
        "radius": 0.55
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.6, 2.4)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(v.particle_age * 60 + v.particle_random_1 * 360) * 0.25",
          "math.cos(v.particle_age * 50 + v.particle_random_2 * 360) * 0.12",
          "math.cos(v.particle_age * 70 + v.particle_random_3 * 360) * 0.25"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7 + v.particle_random_3 * 0.5",
          "0.7 + v.particle_random_3 * 0.5"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.1",
          "0.13",
          "0.17",
          "math.clamp(math.min(v.particle_age * 2, (v.particle_lifetime - v.particle_age) * 2), 0, 1) * 0.11"
        ]
      }
    }
  }
}
