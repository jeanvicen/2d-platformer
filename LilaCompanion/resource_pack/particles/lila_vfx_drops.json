{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:vfx_drops",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/vfx/drop"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.cr = v.cr ?? 1; v.cg = v.cg ?? 1; v.cb = v.cb ?? 1; v.dr = v.dr ?? 0; v.dg = v.dg ?? 0; v.db = v.db ?? 0; v.size = v.size ?? 1; v.life = v.life ?? 0.5; v.n = v.n ?? 12; v.rot = v.rot ?? 0; v.h = v.h ?? 6; v.race = v.race ?? 0; v.grav = v.grav ?? 4; v.out = v.out ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.n"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "0.25 * v.size",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(2, 5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "coefficient_of_restitution": 0,
        "collision_radius": 0.05,
        "expire_on_contact": false
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.random(0.06, 0.12)",
          "math.random(0.06, 0.12)"
        ],
        "facing_camera_mode": "direction_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        },
        "direction": {
          "mode": "derive_from_velocity"
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(v.cr, v.dr, v.particle_random_3 * 0.5)",
          "math.lerp(v.cg, v.dg, v.particle_random_3 * 0.5)",
          "math.lerp(v.cb, v.db, v.particle_random_3 * 0.5)",
          "math.min(1, (1 - (v.particle_age / v.particle_lifetime)) * 3)"
        ]
      }
    }
  }
}
