{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_form",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/nano"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.323, 0.38)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-180, 180)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07",
          "0.07"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFF8128",
            "0.25": "#FF1C1A21",
            "0.8": "#FF151318",
            "1.0": "#00151318"
          }
        }
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.particle_random_1 * 360)) * math.cos((v.particle_random_2 * 180 - 90)) * math.pow(1 - v.particle_age / v.particle_lifetime, 2) * 1.3",
          "math.sin((v.particle_random_2 * 180 - 90)) * math.pow(1 - v.particle_age / v.particle_lifetime, 2) * 1.3",
          "math.sin((v.particle_random_1 * 360)) * math.cos((v.particle_random_2 * 180 - 90)) * math.pow(1 - v.particle_age / v.particle_lifetime, 2) * 1.3"
        ]
      },
      "minecraft:emitter_initialization": {
        "creation_expression": "v.yaw = v.yaw ?? 0; v.flap = v.flap ?? 0; v.size = v.size ?? 1;"
      }
    }
  }
}
