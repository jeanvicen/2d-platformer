{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:curse_slash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/vfx/smoke"
      }
    },
    "components": {
