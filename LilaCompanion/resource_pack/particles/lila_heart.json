{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:respawn",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/sparkle"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 64
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.6
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0.1,
          0
        ],
        "radius": 1.2,
        "direction": "outwards",
        "plane_normal": "y"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 2.2)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-180, 180)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.6,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.2 * (1 - v.particle_age / v.particle_lifetime * 0.7)",
          "0.2 * (1 - v.particle_age / v.particle_lifetime * 0.7)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFE6FFF0",
            "0.35": "#FF5BE0A0",
            "1.0": "#0018804F"
          }
        }
      }
    }
  }
}
