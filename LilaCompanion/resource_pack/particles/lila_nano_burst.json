{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:nano_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/nano"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.size = v.size ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 360
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.1)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.particle_random_1 * 360) + (v.particle_age / v.particle_lifetime) * 120) * math.cos((v.particle_random_2 * 180 - 90)) * (0.6 + (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 3)) * 2.6 * v.particle_random_3) * v.size",
          "(math.sin((v.particle_random_2 * 180 - 90)) * (0.5 + (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 3)) * 1.8 * v.particle_random_3) + 0.7) * v.size",
          "math.sin((v.particle_random_1 * 360) + (v.particle_age / v.particle_lifetime) * 120) * math.cos((v.particle_random_2 * 180 - 90)) * (0.6 + (1 - math.pow(1 - (v.particle_age / v.particle_lifetime), 3)) * 2.6 * v.particle_random_3) * v.size"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.028 + v.particle_random_3 * 0.022",
          "0.028 + v.particle_random_3 * 0.022"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_4 > 0.83 ? 0.55 + 0.45 * math.sin(v.particle_age * 900 + v.particle_random_1 * 360) : 0.12",
          "v.particle_random_4 > 0.83 ? 0.92 : 0.15",
          "v.particle_random_4 > 0.83 ? 1.0 : 0.19",
          "math.clamp(math.min(v.particle_age * 5, (v.particle_lifetime - v.particle_age) * 4), 0, 1) * 0.95"
        ]
      }
    }
  }
}
