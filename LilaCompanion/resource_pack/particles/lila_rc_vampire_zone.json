{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lila:rc_vampire_zone",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lila/soft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.size = v.size ?? 3;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 40
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.0)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.particle_random_1 * 360 + v.particle_age * (v.particle_random_2 > 0.5 ? 90 : -90))) * v.size * (0.85 + v.particle_random_3 * 0.2)",
          "0.1 + v.particle_age * 0.4",
          "math.sin((v.particle_random_1 * 360 + v.particle_age * (v.particle_random_2 > 0.5 ? 90 : -90))) * v.size * (0.85 + v.particle_random_3 * 0.2)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.20800000000000002 * (1 - v.particle_age / v.particle_lifetime * 0.6)",
          "0.20800000000000002 * (1 - v.particle_age / v.particle_lifetime * 0.6)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFF3040",
            "0.5": "#FF8A0818",
            "1.0": "#00400008"
          }
        }
      }
    }
  }
}
