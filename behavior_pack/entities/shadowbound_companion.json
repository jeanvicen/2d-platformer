{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "shadowbound:companion",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "shadowbound:anim": { "type": "int", "range": [0, 15], "default": 0, "client_sync": true },
        "shadowbound:persona": { "type": "int", "range": [0, 3], "default": 0, "client_sync": true },
        "shadowbound:mood": { "type": "int", "range": [0, 4], "default": 0, "client_sync": true }
      }
    },
    "component_groups": {
      "shadowbound:tamed": {
        "minecraft:is_tamed": {}
      },
      "shadowbound:mode_follow": {
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.hurt_by_target": {
          "priority": 2,
          "entity_types": { "filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" } }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 12.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "monster" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "creeper" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "enderman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "zombie_pigman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "piglin" }
                ]
              },
              "max_dist": 12
            }
          ]
        },
        "minecraft:behavior.melee_attack": { "priority": 4, "speed_multiplier": 1.3, "track_target": true, "reach_multiplier": 1.6 },
        "minecraft:behavior.follow_owner": { "priority": 6, "speed_multiplier": 1.15, "start_distance": 7, "stop_distance": 3 }
      },
      "shadowbound:mode_guard": {
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.hurt_by_target": {
          "priority": 2,
          "entity_types": { "filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "player" } }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 10.0,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "monster" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "enderman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "zombie_pigman" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "piglin" }
                ]
              },
              "max_dist": 10
            }
          ]
        },
        "minecraft:behavior.melee_attack": { "priority": 4, "speed_multiplier": 1.3, "track_target": true, "reach_multiplier": 1.6 }
      },
      "shadowbound:mode_scripted": {
        "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6, "probability": 0.02 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["shadowbound", "companion", "mob"] },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:movement": { "value": 0.3 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": true,
        "can_pass_doors": true,
        "can_swim": true,
        "can_walk": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:annotation.open_door": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:persistent": {},
      "minecraft:knockback_resistance": { "value": 0.3 },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:tameable": {
        "probability": 0.0,
        "tame_items": "minecraft:structure_void",
        "tame_event": { "event": "shadowbound:on_tame", "target": "self" }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": "no" },
          { "cause": "suffocation", "deals_damage": "no" },
          {
            "on_damage": { "filters": { "test": "is_family", "subject": "other", "value": "player" } },
            "deals_damage": "no"
          },
          {
            "on_damage": { "filters": { "test": "is_family", "subject": "other", "value": "shadowbound" } },
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:equipment": {
        "slot_drop_chance": [
          { "slot": "slot.weapon.mainhand", "drop_chance": 0.0 },
          { "slot": "slot.weapon.offhand", "drop_chance": 0.0 },
          { "slot": "slot.armor.head", "drop_chance": 0.0 },
          { "slot": "slot.armor.chest", "drop_chance": 0.0 },
          { "slot": "slot.armor.legs", "drop_chance": 0.0 },
          { "slot": "slot.armor.feet", "drop_chance": 0.0 }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8, "probability": 0.04 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["shadowbound:mode_follow"] }
      },
      "shadowbound:on_tame": {
        "add": { "component_groups": ["shadowbound:tamed"] }
      },
      "shadowbound:mode_follow": {
        "remove": { "component_groups": ["shadowbound:mode_guard", "shadowbound:mode_scripted"] },
        "add": { "component_groups": ["shadowbound:mode_follow"] }
      },
      "shadowbound:mode_guard": {
        "remove": { "component_groups": ["shadowbound:mode_follow", "shadowbound:mode_scripted"] },
        "add": { "component_groups": ["shadowbound:mode_guard"] }
      },
      "shadowbound:mode_scripted": {
        "remove": { "component_groups": ["shadowbound:mode_follow", "shadowbound:mode_guard"] },
        "add": { "component_groups": ["shadowbound:mode_scripted"] }
      }
    }
  }
}
